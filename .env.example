# Copy to .env and fill in. NEVER commit .env.
DEBUG=True
DJANGO_SECRET_KEY=change-me
DATABASE_URL=postgres://shopsync:shopsync@db:5432/shopsync
REDIS_URL=redis://redis:6379/0
ALLOWED_HOSTS=localhost,127.0.0.1,backend
APP_URL=http://localhost:8000

# Shopify app credentials (Dev Dashboard -> ShopSync -> Settings)
SHOPIFY_API_KEY=
SHOPIFY_API_SECRET=
SHOPIFY_SCOPES=read_products,write_products,read_inventory,write_inventory,read_orders,read_locations
