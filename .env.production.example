# Production environment reference (set these in the Render dashboard, NOT in a committed file).
DEBUG=False
DJANGO_SECRET_KEY=<generated by Render>
FIELD_ENCRYPTION_KEY=<Fernet key>
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DB?sslmode=require   # Neon pooled string
REDIS_URL=<Render key value connection string>
ALLOWED_HOSTS=shopsync-api.onrender.com
APP_URL=https://shopsync-api.onrender.com
CSRF_TRUSTED_ORIGINS=https://shopsync-api.onrender.com
CORS_ALLOWED_ORIGINS=https://your-dashboard.vercel.app
SHOPIFY_API_KEY=<Client ID>
SHOPIFY_API_SECRET=<Client secret>
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
DEFAULT_FROM_EMAIL=ShopSync <alerts@yourdomain.com>
# Vercel (frontend) build variables:
#   VITE_API_URL=https://shopsync-api.onrender.com
#   VITE_SHOPIFY_API_KEY=<Client ID>
